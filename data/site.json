  "statements": {
    "sports_barbecue": {
      "label": {
        "en": "Sports Barbecue",
        "ko": "스포츠바비큐",
        "ja": "スポーツバーベキュー",
        "zh": "运动烧烤"
      },
      "text": {
        "en": "Sports Barbecue revives humankind's first cooking with fire as ritual.\n\nCompetition before the fire is a performance that invokes freedom, equality and peace,\nand a noble expression of human survival.\n\nThrough Sports Barbecue we restore lost humanity,\nand rebuild a crumbling community of shared fate.\n\nAnd so,\n\nwe become a new humankind who build a world worth living in,\nthe HomoNallarians.",
        "ko": "스포츠바비큐는 인류 최초의 화식⁠(火食)을 의식⁠(Ritual)으로 되살린다.\n\n불 앞의 경쟁은 자유와 평등, 그리고 평화를 염원하는 퍼포먼스이며,\n인간 생존의 숭고한 표현이다.\n\n우리는 스포츠바비큐로 잃어버린 인간성을 회복하고,\n무너지는 공동운명체를 복원한다.\n\n그리고,\n\n살 맛 나는 세상을 만들어 가는 새로운 인류,\n호모날라리언스⁠(HomoNallarians)가 된다.",
        "ja": "スポーツバーベキューは、人類最初の火食（かしょく）を儀式（Ritual）としてよみがえらせる。\n\n火の前の競い合いは、自由と平等、そして平和を祈るパフォーマンスであり、\n人間の生存の崇高な表現である。\n\n私たちはスポーツバーベキューによって、失われた人間性を回復し、\n崩れゆく運命共同体を復元する。\n\nそして、\n\n生きがいのある世の中をつくっていく新しい人類、\nホモナラリアンス（HomoNallarians）となる。",
        "zh": "运动烧烤以仪式（Ritual）唤醒人类最初的火食。\n\n火前的竞技，是祈愿自由与平等、以及和平的表演，\n也是人类生存的崇高表达。\n\n我们借由运动烧烤，恢复失落的人性，\n修复正在瓦解的命运共同体。\n\n然后，\n\n我们成为创造值得活下去的世界的新人类，\nHomoNallarians。"
      }
    },
    "motto": {
      "label": {
        "en": "Motto",
        "ko": "모토",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "You and I, and We",
        "ko": "너와 나, 그리고 우리",
        "ja": "あなたと私、そして私たち",
        "zh": "你和我，还有我们"
      }
    },
    "creed": {
      "label": {
        "en": "Pro Barbecuer's Creed",
        "ko": "프로바비큐어 신조",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "Victory in Sports Barbecue is not the result of another's defeat,\nbut a glory conferred by those who did not win.",
        "ko": "스포츠바비큐의 승리는 누군가의 패배로 이룬 결과가 아니라,\n패자의 추대로 얻은 영광이다.",
        "ja": "",
        "zh": ""
      }
    },
    "spirit": {
      "label": {
        "en": "Spirit of the Game",
        "ko": "경기정신",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "Sports Barbecue is not a prize seized on sacrifice,\nbut a fruit ripened in sharing.",
        "ko": "스포츠바비큐는 희생 위에 세운 쟁취가 아니라,\n나눔 속에 맺힌 결실이다.",
        "ja": "スポーツバーベキューは、犠牲の上に勝ち取ったものではなく、\n分かち合いの中で実った結実である。",
        "zh": "运动烧烤不是建立在牺牲之上的夺取，\n而是在分享中结出的果实。"
      }
    },
    "slogan": {
      "label": {
        "en": "Slogan",
        "ko": "슬로건",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "DO NOT DO IF NOT FUN",
        "ko": "",
        "ja": "",
        "zh": ""
      }
    },
    "hwahap": {
      "label": {
        "en": "Pyrokoinonia",
        "ko": "화합(火合)",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "Sport demanded harmony in the midst of rivalry.\nSports Barbecue demands nothing.\nThose who sit before one fire are already one.",
        "ko": "스포츠는 겨루면서 화합하라고 요구했다.\n스포츠바비큐는 요구하지 않는다.\n같은 불 앞에 앉은 사람은 이미 하나다.\n和合은 강요되었고, 火合은 저절로 온다.",
        "ja": "",
        "zh": ""
      }
    },
    "mission": {
      "label": {
        "en": "Mission",
        "ko": "사명",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "The Federation connects the Sports Barbecue cultures of every nation,\nrecords each nation's traditional barbecue as a shared heritage of humankind,\nand builds a world worth living in\nby restoring lost humanity and a crumbling community of shared fate.",
        "ko": "연맹은 각국의 스포츠바비큐 문화를 하나로 연결하고,\n각국의 전통적인 바비큐를 인류 공동의 문화유산으로 기록하며,\n잃어버린 인간성과 무너지는 공동운명체 복원을 통해\n살 맛 나는 세상을 만들어 간다.",
        "ja": "",
        "zh": ""
      }
    },
    "pro_barbecuer": {
      "label": {
        "en": "The Pro Barbecuer",
        "ko": "프로바비큐어",
        "ja": "",
        "zh": ""
      },
      "text": {
        "en": "A Pro Barbecuer officiates the ritual on the foundation of barbecue humanities and philosophical humanism,\nand carries a sense of mission for the common prosperity of humankind.",
        "ko": "프로바비큐어는 바비큐 인문학과 철학적 인본을 바탕으로 의식을 집전하며,\n인류공영의 사명감을 갖는다.",
        "ja": "",
        "zh": ""
      }
    }
  },
